[Unit]
Description=Desktop dashboard layer-shell wallpaper surface
Documentation=file:%h/Code/Dashboards/desktop/README.md
PartOf=graphical-session.target
After=graphical-session.target desktop-dashboard-serve.service
Wants=desktop-dashboard-serve.service

[Service]
Type=simple
# GTK3 + gtk-layer-shell; the host waits on /api/health before mapping.
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 %h/Code/Dashboards/desktop/bin/dashd-host
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
